<div class="skin-cosmos-profile__heading hgroup">
	<h1 itemprop="name">{{name}}</h1>
	{{#array-tags}}<span class="skin-cosmos-profile__tag tag {{class}}">{{text}}</span>{{/array-tags}}
</div>
{{#data-editcount}}
<div class="skin-cosmos-profile__contributions skin-cosmos-profile__tally contributions-details tally">
	<a href="{{url}}"><em>{{count}}</em><span>{{label}}<br>{{registration}}</span></a>
</div>
{{/data-editcount}}
{{#bio}}<p class="skin-cosmos-profile__bio bio">{{.}}</p>{{/bio}}
