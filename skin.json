	"config": {
		"CosmosBetaAllowFooterIconHiding": {
			"value": true,
			"description": "Whether the theme designer may hide the footer icons."
		},
		"CosmosBetaBackgroundImage": {
			"value": false,
			"description": "Adds a background image to the page body (behind the content area)"
		},
		"CosmosBetaBackgroundImageFixed": {
			"value": true,
			"description": "If true the background image will be set to position: fixed"
		},
		"CosmosBetaBackgroundImageRepeat": {
			"value": false,
			"description": "If true the background image will be set to 'repeat' otherwise, if false, it will be set to 'no-repeat'"
		},
		"CosmosBetaBackgroundImageSize": {
			"value": "cover",
			"description": "Sets the background image size for the body background if set"
		},
		"CosmosBetaBannerBackgroundColor": {
			"value": "#c0c0c0",
			"description": "Changes the background color of the personal navigation"
		},
		"CosmosBetaButtonBackgroundColor": {
			"value": "#c0c0c0",
			"description": "Changes the background color of the page action buttons for Cosmos"
		},
		"CosmosBetaContentBackgroundColor": {
			"value": "#ffffff",
			"description": "Changes the background color of the wiki article area"
		},
		"CosmosBetaContentOpacityLevel": {
			"value": 100,
			"description": "Set the content area background opacity in percentage (without the percent symbol)"
		},
		"CosmosBetaContentWidth": {
			"value": "default",
			"description": "Sets the main content area width. Can be 'default', 'large', or 'full'."
		},
		"CosmosBetaEnablePortableInfoboxEuropaTheme": {
			"value": true,
			"description": "Enables the Europa theme from Fandom's portable infobox extension on the ported extension."
		},
		"CosmosBetaEnableWantedPages": {
			"value": true,
			"description": "Whether or not to enable the WantedPages feature of the create page dialogue."
		},
		"CosmosBetaEnabledRailModules": {
			"value": {
				"recentchanges": false,
				"interface": [
					{
						"cosmosbeta-custom-rail-module": "normal",
						"cosmosbeta-custom-sticky-rail-module": "sticky"
					}
				]
			},
			"description": "Sets which rail modules will be enabled on Cosmos, and whether they are 'sticky' or 'normal'"
		},
		"CosmosBetaFetchWantedPagesFromCache": {
			"value": false,
			"description": "Whether or not to fetch the wanted pages shown within the create page dialogue from cache. If enabled you will need to run php updateSpecialPages.php --only=WantedPages in order to update the wanted pages. It is recommended to set this to true on large wikis."
		},
		"CosmosBetaFooterBackgroundColor": {
			"value": "#c0c0c0",
			"description": "Changes the background color of the footer"
		},
		"CosmosBetaFooterProtectedLinks": {
			"value": [
				"about",
				"copyright",
				"disclaimers",
				"privacy"
			],
			"description": "Names of footer links that the theme designer is not allowed to hide."
		},
		"CosmosBetaLinkColor": {
			"value": "#0645ad",
			"description": "Changes the color of links in the cosmos wiki article area"
		},
		"CosmosBetaMainBackgroundColor": {
			"value": "#1A1A1A",
			"description": "Adds a background color to the page body (behind the content area)"
		},
		"CosmosBetaMaxSearchResults": {
			"value": 10
		},
		"CosmosBetaRailDisabledNamespaces": {
			"value": [
				-1,
				8,
				9
			],
			"description": "List of namespaces to disable the rail in."
		},
		"CosmosBetaRailDisabledPages": {
			"value": [
				"mainpage"
			],
			"description": "List of pages to disable the rail in."
		},
		"CosmosBetaRailSidebarPortlets": {
			"value": [
				"USER-SIDEBAR"
			],
			"description": "Names of sidebar sections, such as the one from the DynamicSidebar extension, that are shown as rail modules instead of in the top navigation."
		},
		"CosmosBetaSearchDescriptionSource": {
			"value": "textextracts"
		},
		"CosmosBetaSearchHost": {
			"value": ""
		},
		"CosmosBetaSearchOptions": {
			"value": {
				"showThumbnail": true,
				"showDescription": true
			}
		},
		"CosmosBetaSearchUseActionAPI": {
			"value": false
		},
		"CosmosBetaSocialProfileAllowBio": {
			"value": true,
			"description": "Allows users to add a bio to display on their user pages, through Special:MyPage/bio"
		},
		"CosmosBetaSocialProfileFollowBioRedirects": {
			"value": false,
			"description": "Whether or not to follow redirects from Special:MyPage/bio and display the redirect target as bio instead (experimental)"
		},
		"CosmosBetaSocialProfileModernTabs": {
			"value": true,
			"description": "Enables a modern version of the tabs on SocialProfile profile pages"
		},
		"CosmosBetaSocialProfileNumberofGroupTags": {
			"value": 2,
			"description": "Set the max number of group tags to show on a user's SocialProfile page if they have them"
		},
		"CosmosBetaSocialProfileRoundAvatar": {
			"value": true,
			"description": "Makes the avatar round on SocialProfile profile pages"
		},
		"CosmosBetaSocialProfileShowEditCount": {
			"value": true,
			"description": "Show's the edit count and registration date for the user on SocialProfile profile pages, underneath their username"
		},
		"CosmosBetaSocialProfileShowGroupTags": {
			"value": true,
			"description": "Enables usergroup tags to appear next to user's username on SocialProfile profile pages"
		},
		"CosmosBetaSocialProfileTagGroups": {
			"value": [
				"bureaucrat",
				"bot",
				"sysop",
				"interface-admin"
			],
			"description": "Array of usergroups to show on SocialProfile pages if the user has them"
		},
		"CosmosBetaThemeDesignerOnly": {
			"value": false,
			"description": "If true the theme designer is the only place the theme is set. The other theme variables (colors, images, content width and opacity, background options, the rail defaults, and the Europa infobox theme) are ignored, and the designer starts from built in defaults. Run maintenance/run.php CosmosBeta:ImportConfigTheme first to keep the current look."
		},
		"CosmosBetaThemeDesignerPublicView": {
			"value": false,
			"description": "If true anyone can open the theme designer. People without the cosmosbeta-themedesigner right see it read only, and publishing fails for them."
		},
		"CosmosBetaToolbarBackgroundColor": {
			"value": "#000000",
			"description": "Changes the background color of the toolbar"
		},
		"CosmosBetaUseSocialProfileAvatar": {
			"value": true,
			"description": "Use SocialProfile avatar as avatar next to username in top banner"
		},
		"CosmosBetaUseUPv2Avatar": {
			"value": true,
			"description": "Use UserProfileV2 avatar as avatar next to username in top banner"
		},
		"CosmosBetaWantedPagesFetchedNamespaces": {
			"value": [
				0
			],
			"description": "Set to an array of namespaces to fetch wanted pages from, if wanted pages are enabled for the create page dialogue."
		},
		"CosmosBetaWantedPagesMaxTitlesCount": {
			"value": 6,
			"description": "Set to the max number of wanted pages to display in the create page dialogue, if wanted pages are enabled."
		},
		"CosmosBetaWikiHeaderBackgroundColor": {
			"value": "#c0c0c0",
			"description": "Changes the background color of the wiki navigation"
		},
		"CosmosBetaWikiHeaderBackgroundImage": {
			"value": false,
			"description": "Adds a background image to the wiki navigation"
		},
		"CosmosBetaWordmark": {
			"value": false,
			"description": "Adds a wordmark to the wiki navigation"
		}
	},
	"HookHandlers": {
		"adminlinks": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\AdminLinks"
		},
		"colormode": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\ColorMode",
			"services": [
				"CosmosBetaAltModules",
				"CosmosBetaEffectiveTheme"
			]
		},
		"themecache": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\ThemeCache",
			"services": [
				"CosmosBetaThemeStore"
			]
		},
		"installer": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\Installer"
		},
		"navigation": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\Navigation",
			"services": [
				"CosmosBetaNavigation",
				"CosmosBetaTemplateParser",
				"TitleFactory"
			]
		},
		"output": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\Output",
			"services": [
				"CosmosBetaEffectiveTheme",
				"CosmosBetaLessUtil"
			]
		},
		"parser": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\Parser"
		},
		"personaltools": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\PersonalTools"
		},
		"railcache": {
			"class": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\RailCache",
			"services": [
				"MainWANObjectCache"
			]
		},
		"socialprofile": {
			"factory": "MediaWiki\\Skin\\Cosmos\\Hooks\\Handlers\\SocialProfile::factory",
			"services": [
				"CosmosBetaOptions",
				"CosmosBetaTemplateParser",
				"TitleFactory",
				"UserGroupManager",
				"WikiPageFactory"
			]
		}
	},
