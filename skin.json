{
	"name": "CosmosBeta",
	"version": "7.1.0",
	"author": [
		"Universal Omega",
		"..."
	],
	"url": "https://www.mediawiki.org/wiki/Skin:Cosmos",
	"descriptionmsg": "cosmosbeta-desc",
	"namemsg": "skinname-cosmosbeta",
	"license-name": "GPL-3.0-or-later",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"ValidSkinNames": {
		"cosmosbeta": {
			"displayname": "CosmosBeta",
			"class": "MediaWiki\\Skins\\CosmosBeta\\SkinCosmosBeta",
			"services": [
				"CosmosBetaAltModules",
				"CosmosBetaConfig",
				"CosmosBetaNavigation",
				"CosmosBetaOptions",
				"CosmosBetaRailBuilder",
				"CosmosBetaWordmarkLookup",
				"ContentLanguage",
				"ExtensionRegistry",
				"LanguageNameUtils",
				"PermissionManager",
				"SpecialPageFactory",
				"TitleFactory",
				"UserOptionsManager"
			],
			"optional_services": [
				"CookieWarning.Decisions"
			],
			"args": [
				{
					"name": "cosmosbeta",
					"responsive": true,
					"bodyClasses": [
						"skin-cosmos-search-vue"
					],
					"menus": [
						"associated-pages",
						"views",
						"actions",
						"variants",
						"user-page",
						"user-interface-preferences",
						"notifications",
						"user-menu"
					],
					"styles": [
						"skins.cosmosbeta.styles",
						"skins.cosmosbeta.icons"
					],
					"scripts": [
						"skins.cosmosbeta.searchLoader",
						"skins.cosmosbeta.js"
					],
					"link": {
						"text-wrapper": {
							"tag": "span"
						}
					},
					"messages": [
						"cosmosbeta-colormode-switch-light",
						"cosmosbeta-colormode-switch-dark"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"CosmosBeta": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"CosmosBetaAliases": "CosmosBetaAliases.php",
		"CosmosBetaMagic": "CosmosBetaMagic.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skins\\CosmosBeta\\": "includes/",
		"MediaWiki\\Skins\\CosmosBeta\\Maintenance\\": "maintenance/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"ConfigRegistry": {
		"CosmosBeta": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"GroupPermissions": {
		"sysop": {
			"cosmosbeta-themedesigner": true
		}
	},
	"AvailableRights": [
		"cosmosbeta-themedesigner"
	],
	"SpecialPages": {
		"CosmosBetaThemeDesigner": {
			"class": "MediaWiki\\Skins\\CosmosBeta\\Specials\\SpecialThemeDesigner",
			"services": [
				"CosmosBetaConfig",
				"CosmosBetaThemeStore",
				"ExtensionRegistry",
				"SkinFactory",
				"TitleFactory"
			]
		}
	},
	"ResourceModules": {
		"skins.cosmosbeta.styles": {
			"features": {
				"content-links": true,
				"content-media": true,
				"content-tables": true,
				"elements": true,
				"interface": true,
				"interface-category": true,
				"interface-message-box": false,
				"logo": true,
				"normalize": true
			},
			"styles": {
				"resources/skins.cosmosbeta.styles/common.less": {
					"media": "screen"
				},
				"resources/skins.cosmosbeta.styles/desktop.less": {
					"media": "screen and (min-width: 851px)"
				},
				"resources/skins.cosmosbeta.styles/desktop-mid.less": {
					"media": "screen and (min-width: 1100px) and (max-width: 1339px)"
				},
				"resources/skins.cosmosbeta.styles/desktop-small.less": {
					"media": "screen and (min-width: 851px) and (max-width: 1099px)"
				},
				"resources/skins.cosmosbeta.styles/mobile.less": {
					"media": "screen and (max-width: 850px)"
				},
				"resources/skins.cosmosbeta.styles/print.less": {
