	"ValidSkinNames": {
		"cosmosbeta": {
			"displayname": "CosmosBeta",
			"factory": "MediaWiki\\Skin\\Cosmos\\SkinCosmos::factory",
			"services": [
				"CosmosBetaAltModules",
				"CosmosBetaOptions",
				"CosmosBetaNavigation",
				"CosmosBetaEffectiveTheme",
				"CosmosBetaRailBuilder",
				"CosmosBetaWordmarkLookup",
				"ContentLanguageCode",
				"ExtensionRegistry",
				"LanguageNameUtils",
				"PermissionManager",
				"SpecialPageFactory",
				"TitleFactory",
				"UserOptionsManager"
			],
			"optional_services": [
				"CookieWarning.Decisions"
			],
			"args": [
				{
					"name": "cosmosbeta",
					"responsive": true,
					"wrapSiteNotice": true,
					"clientPrefEnabled": true,
					"bodyClasses": [
						"skin-cosmos-has-vue-search"
					],
					"menus": [
						"associated-pages",
						"views",
						"actions",
						"variants",
						"user-page",
						"user-interface-preferences",
						"notifications",
						"user-menu"
					],
					"styles": [
						"skins.cosmosbeta.styles",
						"skins.cosmosbeta.icons"
					],
					"scripts": [
						"skins.cosmosbeta.searchLoader",
						"skins.cosmosbeta.js"
					],
					"link": {
						"text-wrapper": {
							"tag": "span"
						}
					},
					"messages": [
						"cosmosbeta-colormode-switch-light",
						"cosmosbeta-colormode-switch-dark"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"CosmosBeta": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"CosmosBetaAliases": "CosmosBetaAliases.php",
		"CosmosBetaMagic": "CosmosBetaMagic.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skin\\Cosmos\\": "includes/",
		"MediaWiki\\Skin\\Cosmos\\Maintenance\\": "maintenance/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"ConfigRegistry": {
		"CosmosBeta": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"GroupPermissions": {
		"sysop": {
			"cosmosbeta-themedesigner": true,
			"cosmosbeta-admindashboard": true
		}
	},
	"AvailableRights": [
		"cosmosbeta-admindashboard",
		"cosmosbeta-themedesigner"
	],
	"SpecialPages": {
		"CosmosBetaThemeDesigner": {
			"class": "MediaWiki\\Skin\\Cosmos\\Specials\\SpecialThemeDesigner",
